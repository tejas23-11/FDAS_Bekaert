[Unit]
Description=FDAS Alarm Notification System - operator dashboard (step 14)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/pi/fdas-project
ExecStart=/home/pi/fdas-project/venv/bin/python3 -m ui.app
Restart=on-failure
RestartSec=5
User=pi

[Install]
WantedBy=multi-user.target
